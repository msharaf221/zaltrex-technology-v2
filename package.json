    "test:ai-security": "node --conditions=react-server --experimental-strip-types scripts/test-ai-security.mjs",
    "test:sast": "python3 scripts/sast-scan.py",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json"
  },
  "dependencies": {
    "@next/swc-linux-x64-gnu": "^16.3.8",
