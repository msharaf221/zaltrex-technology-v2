# Copy to .env.local. Fill real secrets ONLY in .env.local / your hosting secret settings.
# Never commit .env.local or include it in downloads.

# Public Supabase project values. The same project can serve the website and Admin Panel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# NEVER expose a Supabase service_role key in either frontend.

# Server-only Google Gemini credential. NEVER prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Automatically used only for a transient outage/network error or missing primary model.
# Set to 'none' to disable fallback.
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Production AI requires this durable limiter (development uses a conservative shared local bucket).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_RATE_LIMIT_SALT=
# Only true when your trusted ingress strips/overwrites incoming X-Forwarded-For.
AI_TRUST_PROXY=false

# Exact public production origin, for example https://your-domain.com (no path).
SITE_URL=
